# Publish only the small set of conference materials below.
# Everything else stays on disk locally, including datasets and class notebooks.
/*
!/.gitignore
!/README.md
!/environment.yml
!/workshop/

/workshop/*
!/workshop/README.md
!/workshop/CLOUDBANK_SETUP.md
!/workshop/notebooks/
!/workshop/part1/
!/workshop/reports/

/workshop/notebooks/*
!/workshop/notebooks/02_oceanography.ipynb
!/workshop/notebooks/03_microscopy.ipynb

/workshop/part1/*
!/workshop/part1/prompts/
/workshop/part1/prompts/*
!/workshop/part1/prompts/visual_framing.md

/workshop/reports/*
!/workshop/reports/microscopy_analysis_report.pdf
!/workshop/reports/oceanography_dataset_report.pdf

# Explicitly exclude the existing classroom notebooks, wherever they are saved.
**/GPU*.ipynb
**/LEC-1*.ipynb

# When the slides are final, add an exception for their exact path here.
# Ignore rules do not remove files from previous commits.
